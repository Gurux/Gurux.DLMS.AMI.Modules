<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <AmiModuleCompatibilityMetadata>true</AmiModuleCompatibilityMetadata>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <Company>Gurux Ltd</Company>
        <Authors>Gurux Ltd</Authors>
        <Copyright>Copyright (c) 1998-2026 Gurux Ltd. All rights reserved.</Copyright>
        <PackageProjectUrl>www.gurux.fi/Gurux.DLMS.AMI4</PackageProjectUrl>
        <Description>Gurux.AMI.SMTP adds SMTP support for Gurux DLMS AMI.</Description>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' == '' ">0.0.1-local</Version>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' != '' ">$(BUILD_BUILDNUMBER)</Version>
        <Version Condition="'$(AmiModuleReleaseVersion)' != ''">$(AmiModuleReleaseVersion)</Version>
        <RepositoryUrl>https://github.com/gurux/gurux.dlms.ami4</RepositoryUrl>
        <PackageTags>Gurux Device Framework Network DLMS AMI</PackageTags>
        <PackageId>Gurux.AMI.SMTP</PackageId>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    </PropertyGroup>


    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.13" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Gurux.UI.Components" Version="4.0.2610.2702" />
        <PackageReference Include="Gurux.DLMS.AMI.Module" Version="4.1.2610.2703" />
        <PackageReference Include="Gurux.DLMS.AMI.Services" Version="4.1.2610.2701" />
        <PackageReference Include="Gurux.DLMS.AMI.Shared" Version="4.1.2610.2702" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
    <Target Name="ZipPublish" AfterTargets="Publish">
        <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ProjectDir)bin/$(Configuration)/Gurux.AMI.SMTP-$(Version).zip" Overwrite="true" />
    </Target>
</Project>


